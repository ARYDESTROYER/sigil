# Caddy reverse proxy for sigild. SKELETON — not applied.
# Replace api.example.com with the real api.<host> once the domain resolves.
#
# WALL-CLOCK GATE: the DNS A record must resolve before Caddy can obtain a
# Let's Encrypt cert (ACME validation). Budget retry/backoff on first boot.
#
# ⚠️ PQ-TLS NOTE: this edge terminates TLS with Caddy's classical groups. The
# X25519MLKEM768 hybrid proof in the sprint must be run against the GO-NATIVE
# sigild listener (Go 1.24.x, CurvePreferences=nil), NOT this Caddy edge. Do not
# mislabel a Caddy classical handshake as the PQ proof.

# ⚠️ EDGE RATE LIMITING — READ THIS BEFORE ENABLING sigild's OWN LIMITER.
#
# sigild has an in-process abuse limiter (SIGILD_ENROLL_RATE_LIMIT /
# SIGILD_INVITE_RATE_LIMIT, ADR 0041). Behind THIS reverse proxy it is close to
# useless and must be understood as a backstop, not a defence: every request
# reaches sigild from Caddy's address, so the enrollment limiter — which keys on
# the socket peer address and deliberately ignores X-Forwarded-For, because
# trusting it would let one client mint unlimited buckets — collapses to ONE
# global bucket for all traffic. That is precisely why sigild charges its bucket
# only on the DENIAL path and fails OPEN at its key cap: so that this topology
# cannot turn an abuse control into a global enrollment outage.
#
# The component that actually knows the peer is this one. Per-source limiting
# therefore belongs HERE.
#
# STOCK CADDY CANNOT DO IT. Rate limiting is the caddy-ratelimit plugin, not a
# built-in, so the block below is commented out — leaving it live would make
# `caddy validate` fail on a stock binary, and this repo validates its IaC
# offline. To enable it, build a Caddy that has the module:
#
#     xcaddy build --with github.com/mholt/caddy-ratelimit
#
# then uncomment the block inside the site below and re-run `caddy validate`.
#
#	rate_limit {
#		# Enrollment is the one UNAUTHENTICATED write path, and the route a
#		# flood is most useful against. Key on the real client address, which
#		# only the edge knows.
#		zone enroll {
#			match {
#				method POST
#				path /v1/devices/enroll
#			}
#			key    {remote_host}
#			events 10
#			window 1m
#		}
#		# Invite minting is authenticated, so sigild already limits it per
#		# ACCOUNT — which is tighter than anything an address-based edge rule
#		# can express. This zone is only a coarse outer bound.
#		zone invites {
#			match {
#				method POST
#				path /v1/account/invites
#			}
#			key    {remote_host}
#			events 30
#			window 1m
#		}
#	}
#
# ⛔ DO NOT ADD A ZONE FOR /v1/billing/webhook/*. sigild's webhook limiter was
# built, proven harmful and REMOVED (ADR 0041): shedding traffic on a route where
# shedding costs money, and where the legitimate sender has a finite retry
# budget, loses payment events. An edge rule keyed on the provider's address is
# a little better than one keyed on the provider name, but a provider retries
# from a pool you do not control and cannot enumerate. If you bound that route at
# all, bound it by an ALLOWLIST of provider source ranges, never by a rate.

api.example.com {
	encode zstd gzip

	# ⛔ /metrics IS NOT PUBLIC, AND THIS IS THE ONLY THING THAT MAKES THAT TRUE.
	#
	# sigild serves GET /metrics ALWAYS-ON and UNAUTHENTICATED — it is deliberately
	# not dev-gated (ADR 0017), because a metrics endpoint that needs the dev flag
	# is a metrics endpoint nobody scrapes. That is fine on a loopback listener and
	# wrong at a public edge: the bare catch-all `reverse_proxy` below has no path
	# matcher, so before this block existed a public deploy of the documented
	# topology published sigild_account_devices, sigild_device_enrollments_total,
	# sigild_billing_webhooks_total{provider,outcome} and
	# sigild_entitlement_refused_total to the whole internet — i.e. account counts,
	# enrolment volume and payment-refused decisions, readable by anyone, while
	# docs/deployment.md said to keep it internal. Documentation is not a control.
	#
	# 404, not 403: a 403 confirms the route exists.
	#
	# Scrape it from INSIDE the trust boundary (the loopback listener, or a private
	# interface Prometheus can reach), never through this vhost. If it ever must be
	# exposed, replace this block with an authenticated matcher — not by deleting it.
	handle /metrics {
		respond 404
	}

	reverse_proxy 127.0.0.1:8080

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}

	log {
		output stdout
		format json
	}
}
